# ============================================================================
# Plantilla de configuración. Copiar a .env y completar los valores reales.
# NUNCA versionar el .env con secretos.
# ============================================================================

# --- Entorno ---------------------------------------------------------------
APP_ENV=prod                 # dev | prod  (prod activa cookies Secure y valida secretos)
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://bot.tudominio.com   # URL pública del túnel (sin /webhook)

# --- PostgreSQL ------------------------------------------------------------
# Usuario/clave que usará el contenedor de Postgres (los crea la imagen).
POSTGRES_USER=wa
POSTGRES_PASSWORD=cambia-esta-clave-larga
POSTGRES_DB=wa
# Cadena usada por SQLAlchemy (driver async). Host = nombre del servicio compose.
DATABASE_URL=postgresql+asyncpg://wa:cambia-esta-clave-larga@postgres:5432/wa

# --- Sesiones / panel ------------------------------------------------------
# Clave de firma de cookies. Generar con: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=cambia-esta-clave-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia-esta-clave
COOKIE_SECURE=true           # false solo en desarrollo con http://localhost

# --- WhatsApp Cloud API (Meta) --------------------------------------------
WA_PHONE_NUMBER_ID=1387086514492751
WA_WABA_ID=2273785206893498
WA_ACCESS_TOKEN=ROTAR-ESTE-TOKEN-EN-META
WA_VERIFY_TOKEN=mi_token_secreto_123
# App Secret de Meta -> Configuración de la app > Básica. Obligatorio para validar la firma.
WA_APP_SECRET=completar
META_GRAPH_VERSION=v22.0

# --- LLM: Groq (texto y audio) --------------------------------------------
GROQ_API_KEY=completar
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_MAX_OUTPUT_TOKENS=400
LLM_MAX_INPUT_CHARS=6000
LLM_TEMPERATURE=0.3
LLM_MIN_INTERVAL_SECONDS=2.2   # ~27 req/min, debajo del límite free de 30 RPM
WHISPER_MODEL=whisper-large-v3-turbo

# --- Visión: Gemini free (solo imágenes) ----------------------------------
GEMINI_API_KEY=completar
VISION_MODEL=gemini-3.5-flash-lite
VISION_MAX_PIXELS=1024
VISION_MAX_OUTPUT_TOKENS=250

# --- RAG / embeddings locales ---------------------------------------------
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DIM=384
EMBEDDINGS_CACHE_DIR=/models
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=150

# --- Media ----------------------------------------------------------------
MAX_MEDIA_BYTES=20971520     # 20 MB

# --- Cloudflare Tunnel ----------------------------------------------------
# Token del túnel nombrado (Cloudflare Zero Trust > Tunnels). No es la URL.
TUNNEL_TOKEN=completar
