---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ingresar · Panel</title>
  </head>
  <body>
    <main class="login-wrap">
      <section class="card login-card stack">
        <div>
          <h1>Panel del asistente</h1>
          <p class="muted small">Acceso restringido al equipo.</p>
        </div>

        <form id="login-form" class="stack" novalidate>
          <label>
            Correo
            <input type="email" name="email" autocomplete="username" required />
          </label>
          <label>
            Contraseña
            <input type="password" name="password" autocomplete="current-password" required minlength="6" />
          </label>
          <button class="primary" type="submit" id="submit">Ingresar</button>
          <p class="small muted" id="error" role="alert" aria-live="polite"></p>
        </form>
      </section>
    </main>

    <script>
      import { api } from '../lib/api';

      const form = document.querySelector<HTMLFormElement>('#login-form')!;
      const button = document.querySelector<HTMLButtonElement>('#submit')!;
      const error = document.querySelector<HTMLParagraphElement>('#error')!;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        error.textContent = '';
        button.disabled = true;
        button.textContent = 'Ingresando…';

        const data = new FormData(form);
        try {
          await api('/auth/login', {
            method: 'POST',
            body: JSON.stringify({
              email: String(data.get('email') ?? ''),
              password: String(data.get('password') ?? ''),
            }),
          });
          location.href = '/';
        } catch (exc) {
          error.textContent = exc instanceof Error ? exc.message : 'No se pudo iniciar sesión.';
        } finally {
          button.disabled = false;
          button.textContent = 'Ingresar';
        }
      });
    </script>
  </body>
</html>