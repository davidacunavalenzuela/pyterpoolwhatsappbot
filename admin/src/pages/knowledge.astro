---
import Base from '../layouts/Base.astro';
---

<Base title="Conocimiento">
  <div class="stack">
    <div class="spread">
      <div>
        <h1>Base de conocimiento</h1>
        <p class="muted small">
          Manuales en PDF/MD/TXT que el agente consulta con RAG local. La indexación corre en el worker.
        </p>
      </div>
      <button type="button" id="reindex-all">Reindexar todo</button>
    </div>

    <section class="card stack">
      <h2>Subir manual</h2>
      <form id="upload-form" class="form-grid">
        <label class="full">Archivo (PDF, MD o TXT, máx. 20 MB)
          <input type="file" name="file" accept=".pdf,.md,.txt" required />
        </label>
        <label>Título <input name="title" maxlength="200" placeholder="Opcional" /></label>
        <label>Tipo
          <select name="source_type">
            <option value="manual">Manual de uso</option>
            <option value="faq">Preguntas frecuentes</option>
            <option value="policy">Política</option>
            <option value="other">Otro</option>
          </select>
        </label>
        <div class="full row">
          <button class="primary" type="submit">Subir e indexar</button>
          <span class="small muted" id="upload-hint"></span>
        </div>
      </form>
    </section>

    <section class="card stack">
      <div class="spread">
        <h2>Documentos</h2>
        <span class="small muted" id="docs-count"></span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Título</th><th>Tipo</th><th>Estado</th><th>Chunks</th><th>Creado</th><th></th></tr>
          </thead>
          <tbody id="docs"></tbody>
        </table>
      </div>
    </section>

    <section class="card stack">
      <h2>Probar búsqueda</h2>
      <form id="search-form" class="row">
        <input name="q" placeholder="Ej: cómo limpiar la cafetera" minlength="2" required />
        <button type="submit">Buscar</button>
      </form>
      <div id="results" class="stack small"></div>
    </section>
  </div>

  <script>
    import { api, el, fmtDate, statusBadge, toast } from '../lib/api';

    interface Doc {
      id: number;
      title: string;
      source_type: string;
      filename: string | null;
      status: string;
      chunk_count: number;
      error: string | null;
      created_at: string;
    }

    interface Hit {
      titulo: string;
      score: number;
      fragmento: string;
    }

    const docsNode = document.querySelector<HTMLElement>('#docs')!;
    const docsCount = document.querySelector<HTMLElement>('#docs-count')!;
    const uploadForm = document.querySelector<HTMLFormElement>('#upload-form')!;
    const uploadHint = document.querySelector<HTMLElement>('#upload-hint')!;
    const resultsNode = document.querySelector<HTMLElement>('#results')!;

    async function loadDocs() {
      try {
        const data = await api<{ items: Doc[]; total: number }>('/knowledge');
        docsNode.replaceChildren();
        for (const doc of data.items) {
          const tr = el('tr');
          tr.append(el('td', {}, doc.title));
          tr.append(el('td', { class: 'muted' }, doc.source_type));

          const statusCell = el('td');
          statusCell.append(statusBadge(doc.status));
          if (doc.error) statusCell.append(el('div', { class: 'small muted' }, doc.error.slice(0, 120)));
          tr.append(statusCell);

          tr.append(el('td', {}, String(doc.chunk_count)), el('td', { class: 'muted' }, fmtDate(doc.created_at)));

          const actions = el('td');
          const reindex = el('button', { class: 'small', type: 'button' }, 'Reindexar');
          reindex.addEventListener('click', () => reindexDoc(doc));
          const remove = el('button', { class: 'small danger', type: 'button' }, 'Borrar');
          remove.addEventListener('click', () => removeDoc(doc));
          actions.append(reindex, document.createTextNode(' '), remove);
          tr.append(actions);
          docsNode.append(tr);
        }
        if (!data.items.length) {
          const tr = el('tr');
          tr.append(el('td', { colspan: '6', class: 'muted' }, 'Sin documentos. Sube el primer manual.'));
          docsNode.append(tr);
        }
        docsCount.textContent = `${data.total} documentos`;
      } catch (exc) {
        toast(exc instanceof Error ? exc.message : 'No se pudieron cargar los documentos.', 'error');
      }
    }

    uploadForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = uploadForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      uploadHint.textContent = 'Subiendo…';
      try {
        const body = new FormData(uploadForm);
        const doc = await api<Doc>('/knowledge', { method: 'POST', body });
        toast('Documento subido. La indexación corre en segundo plano.');
        uploadForm.reset();
        uploadHint.textContent = doc.status === 'pending' ? 'En cola de indexación.' : '';
        await loadDocs();
      } catch (exc) {
        const message = exc instanceof Error ? exc.message : 'No se pudo subir.';
        uploadHint.textContent = '';
        toast(message, 'error');
      } finally {
        button.disabled = false;
      }
    });

    async function reindexDoc(doc: Doc) {
      try {
        await api(`/knowledge/${doc.id}/reindex`, { method: 'POST' });
        toast('Documento reindexado.');
        await loadDocs();
      } catch (exc) {
        toast(exc instanceof Error ? exc.message : 'No se pudo reindexar.', 'error');
      }
    }

    async function removeDoc(doc: Doc) {
      if (!confirm(`¿Borrar «${doc.title}»? El agente dejará de usarlo.`)) return;
      try {
        await api(`/knowledge/${doc.id}`, { method: 'DELETE' });
        toast('Documento eliminado.');
        await loadDocs();
      } catch (exc) {
        toast(exc instanceof Error ? exc.message : 'No se pudo borrar.', 'error');
      }
    }

    document.querySelector('#reindex-all')?.addEventListener('click', async () => {
      try {
        await api('/knowledge/reindex', { method: 'POST' });
        toast('Reindexación encolada. Puede tardar unos minutos.');
      } catch (exc) {
        toast(exc instanceof Error ? exc.message : 'No se pudo encolar.', 'error');
      }
    });

    document.querySelector<HTMLFormElement>('#search-form')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      const q = String(new FormData(event.currentTarget as HTMLFormElement).get('q') ?? '').trim();
      if (!q) return;
      resultsNode.replaceChildren(el('p', { class: 'muted' }, 'Buscando…'));
      try {
        const data = await api<{ hits: Hit[] }>(`/knowledge/search?q=${encodeURIComponent(q)}`);
        resultsNode.replaceChildren();
        if (!data.hits.length) {
          resultsNode.append(el('p', { class: 'muted' }, 'Sin resultados. Revisa si el documento está indexado.'));
          return;
        }
        for (const hit of data.hits) {
          const card = el('div', { class: 'card stack' });
          card.append(el('strong', {}, `${hit.titulo} · score ${hit.score.toFixed(3)}`));
          card.append(el('p', {}, hit.fragmento));
          resultsNode.append(card);
        }
      } catch (exc) {
        resultsNode.replaceChildren();
        toast(exc instanceof Error ? exc.message : 'Falló la búsqueda.', 'error');
      }
    });

    await loadDocs();
  </script>
</Base>